# Real backend base URL. Defaults to /api (same-origin) if unset.
VITE_API_BASE_URL=/api

# Controls the MSW mock API in both dev AND production builds (e.g. a demo
# deployment with no real backend yet). Set to "false" once a real backend
# is available so the app talks to VITE_API_BASE_URL instead.
VITE_ENABLE_MOCKS=true
