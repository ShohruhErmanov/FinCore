# FinCore backend — nusxa oling: cp .env.example .env
# Bu faylga HECH QACHON haqiqiy parol yoki secret yozmang.

# development | test | production
NODE_ENV=development
PORT=3000

# PostgreSQL. `fincore` sxemasi docs/database/001_reference_schema.sql dan yaratiladi.
# Development'da bo'sh qoldirilsa, API baribir ishga tushadi va
# GET /api/health "NOT_CONFIGURED" deb qaytaradi. Production'da MAJBURIY.
DATABASE_URL=postgresql://fincore_service:__PAROL__@localhost:5432/fincore?schema=fincore

# CORS uchun ANIQ origin. Wildcard (*) qabul qilinmaydi — cookie bilan ishlaydi.
FRONTEND_URL=http://localhost:5173

# Sessiya cookie imzosi. Kamida 32 belgi. Har muhit uchun alohida qiymat:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=__KAMIDA_32_BELGILI_TASODIFIY_QIYMAT__

# Frontend va API bitta domenning subdomenlarida bo'lsa: .fincore.uz
COOKIE_DOMAIN=
# HTTPS'da MAJBURIY true (production'da tekshiriladi). Shunda SameSite=None bo'ladi.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Swagger /api/docs. Production'da MAJBURIY false.
SWAGGER_ENABLED=true

# Umumiy so'rov cheklovi (bir mijoz uchun). Login route'i alohida, qat'iyroq
# cheklovga ega: 60 soniyada 5 urinish (AuthController'da belgilangan).
RATE_LIMIT_MAX=120
RATE_LIMIT_TTL_SECONDS=60

# Audit qilinadigan yozuvlar uchun imzolangan actor token kaliti.
# `npm run init:actor-key` bilan yarating — u fincore._actor_signing_keys ga
# kalit qo'shadi va shu ikki qatorni chiqaradi. Kalitni Git'ga yozmang.
ACTOR_SIGNING_KEY_ID=__UUID__
ACTOR_SIGNING_KEY=__BASE64_32_BAYT__
ACTOR_TOKEN_TTL_SECONDS=60

# --- Telegram (PHASE 38) ----------------------------------------------------
# O'chirilgan holatda hech qanday sir talab qilinmaydi va tarmoqqa chiqilmaydi,
# shuning uchun development va test shu holicha ishlaydi.
# TELEGRAM_ENABLED=true bo'lsa, quyidagi to'rttasi ham majburiy — aks holda
# backend ishga tushmaydi.
#
# Bu qiymatlar HECH QACHON: system_settings'ga yozilmaydi, API javobida
# qaytarilmaydi, logga yoki audit payload'ga tushmaydi.
TELEGRAM_ENABLED=false
# @BotFather bergan token.
TELEGRAM_BOT_TOKEN=
# Bot username, @ belgisisiz — deep link shundan quriladi.
TELEGRAM_BOT_USERNAME=
# setWebhook'dagi secret_token bilan bir xil bo'lishi shart (>= 32 belgi).
TELEGRAM_WEBHOOK_SECRET=
# Ulanish tokenining HMAC kaliti (>= 32 belgi). Xom token hech qayerda saqlanmaydi.
TELEGRAM_LINK_TOKEN_PEPPER=
# Deep link amal qilish muddati (daqiqa).
TELEGRAM_LINK_TOKEN_TTL_MINUTES=10
